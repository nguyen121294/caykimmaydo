generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             String            @default("user")
  accounts         Account[]
  sessions         Session[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  financeAuditLogs FinanceAuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id           String   @id @default(cuid())
  orderId      String   @unique
  customerName String
  phone        String?
  product      String
  productType  String?
  quantity     Int?     @default(1)
  fabricType   String?
  tailorName   String?
  orderDate    String?
  expectedDate String?
  actualDate   String?
  tryDate      String?
  deliveryDate String?
  price        String?
  total        Float?   @default(0)
  deposit      Float?   @default(0)
  department   String?
  status       String   @default("Mới")
  hasMedia     String?  @default("No")
  hasFeedback  String?  @default("No")
  mediaLink    String?
  notes        String?
  action       String?
  source       String?  @default("Khác")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  name        String
  department  String
  assignee    String?
  orderId     String?
  description String?
  startDate   String?
  deadline    String?
  status      String   @default("Chưa làm")
  priority    String   @default("Trung bình")
  note        String?
  checklist   Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TailorChecklist {
  id          String   @id @default(cuid())
  orderId     String
  tailorName  String
  mediaType   String?
  description String?
  quantity    Int?     @default(0)
  deadline    String?
  submitted   String?  @default("Chưa")
  quality     String?
  fileLink    String?
  fileName    String?
  notes       String?
  bonus       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VideoScript {
  id             String   @id @default(cuid())
  scriptId       String   @unique
  funnelStage    String
  contentType    String
  hook           String?
  painPoint      String?
  solution       String?
  cta            String?
  caption        String?
  duration       String?
  targetAudience String?
  expectedKpi    String?
  status         String   @default("Chưa Dùng")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InboxScript {
  id            String   @id @default(cuid())
  customerType  String
  colorTag      String?
  identifiers   String?
  messageNumber String?
  sender        String?
  label         String?
  content       String?
  sheetName     String   @default("Master")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContentTracking {
  id            String   @id @default(cuid())
  contentId     String   @unique
  orderId       String?
  contentType   String?
  channel       String?
  postDate      String?
  views         String?  @default("0")
  saves         String?  @default("0")
  comments      String?  @default("0")
  shares        String?  @default("0")
  engageRate    String?
  usedAds       String?  @default("No")
  adCost        String?
  ordersFromAds String?
  roas          String?
  aiSuggestion  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContentCalendar {
  id          String   @id @default(cuid())
  date        String
  week        String?
  contentType String?
  topic       String?
  channel     String?
  postTime    String?
  orderRef    String?
  status      String   @default("📝 Chưa Làm")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ABTest {
  id                String   @id @default(cuid())
  testId            String   @unique
  testName          String
  dateStarted       String?
  dateEnded         String?
  variantA          String?
  variantB          String?
  budgetA           Float?   @default(0)
  budgetB           Float?   @default(0)
  impressionsA      Float?   @default(0)
  impressionsB      Float?   @default(0)
  clicksA           Float?   @default(0)
  clicksB           Float?   @default(0)
  linkClicksA       Float?   @default(0)
  landingPageViewsA Float?   @default(0)
  conversionsA      Float?   @default(0)
  conversionsB      Float?   @default(0)
  revenueA          Float?   @default(0)
  revenueB          Float?   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamWorkflow {
  id               String   @id @default(cuid())
  roleNumber       String?
  role             String
  responsibilities String?
  sheetsAccess     String?
  accessLevel      String?
  dailyTasks       String?
  weeklyTasks      String?
  tools            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PlatformCredential {
  id          String    @id @default(cuid())
  platform    String    @unique
  credentials String
  isConnected Boolean   @default(false)
  lastTested  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String
  source    String?
  message   String
  details   String?
  createdAt DateTime @default(now())
}

model SyncJob {
  id             String    @id @default(cuid())
  groupId        String
  platform       String
  days           String
  sequence       Int       @default(0)
  status         String    @default("QUEUED")
  stage          String    @default("START")
  cursor         String?
  recordsFetched Int       @default(0)
  recordsSaved   Int       @default(0)
  attempts       Int       @default(0)
  revision       Int       @default(0)
  messageId      String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([groupId, sequence])
  @@index([status, createdAt])
}

model KpiSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  totalOrders    Float?   @default(0)
  totalRevenue   Float?   @default(0)
  totalAdSpend   Float?   @default(0)
  roas           Float?   @default(0)
  conversionRate Float?   @default(0)
  totalContent   Float?   @default(0)
  avgViews       Float?   @default(0)
  saveRate       Float?   @default(0)
  closeRate      Float?   @default(0)
  mediaRate      Float?   @default(0)
  createdAt      DateTime @default(now())
}

model InboxKpi {
  id           String   @id @default(cuid())
  date         String
  customerType String?
  customerId   String?
  status       String?
  lastMessage  String?
  result       String?
  notes        String?
  agent        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalesConversation {
  id                 String         @id @default(cuid())
  platform           String
  externalId         String
  customerExternalId String?
  customerName       String
  customerPhone      String?
  lastMessage        String?
  lastMessageAt      DateTime?
  unreadCount        Int            @default(0)
  messages           SalesMessage[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([platform, externalId])
  @@index([platform, lastMessageAt])
  @@index([lastMessageAt])
}

model SalesMessage {
  id               String            @id @default(cuid())
  conversationId   String
  conversation     SalesConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId       String
  direction        String
  senderExternalId String?
  senderName       String
  text             String
  hasAttachment    Boolean           @default(false)
  sentAt           DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

model SalesInboxSyncState {
  platform          String    @id
  state             String
  detail            String?
  conversationCount Int       @default(0)
  lastAttemptAt     DateTime?
  lastSuccessAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Customer {
  id                  String               @id @default(cuid())
  name                String
  phone               String?
  normalizedPhone     String?              @unique
  email               String?
  zaloId              String?
  source              String?              @default("Khác")
  totalOrders         Int                  @default(0)
  totalSpent          Float                @default(0)
  lastOrder           String?
  tags                String?
  notes               String?
  status              String               @default("Mới")
  // Loyalty fields
  loyaltyPoints       Int                  @default(0)
  loyaltyTier         String               @default("New")
  lastPurchaseDate    String?
  // Customer profile fields
  contactAccount      String?
  address             String?
  // Relations
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  type        String // earn, redeem, adjust, expire
  points      Int
  amount      Float?   @default(0)
  description String?
  createdAt   DateTime @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  source     String?  @default("Facebook")
  stage      String   @default("Mới")
  value      Float    @default(0)
  assignee   String?
  nextAction String?
  nextDate   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FinanceEntry {
  id          String   @id @default(cuid())
  date        String
  type        String   @default("Thu")
  category    String
  description String?
  amount      Float    @default(0)
  orderId     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinanceLedger {
  id        String               @id @default(cuid())
  year      Int                  @unique
  archived  Boolean              @default(false)
  rows      FinanceLedgerRow[]
  months    FinanceMonthStatus[]
  auditLogs FinanceAuditLog[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model FinanceLedgerRow {
  id        String             @id @default(cuid())
  ledgerId  String
  ledger    FinanceLedger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    FinanceLedgerRow?  @relation("FinanceRowTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  FinanceLedgerRow[] @relation("FinanceRowTree")
  label     String
  kind      String             @default("DETAIL")
  sortOrder Int
  values    Json               @default("{}")
  auditLogs FinanceAuditLog[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([ledgerId, sortOrder])
  @@index([parentId])
}

model FinanceMonthStatus {
  id        String        @id @default(cuid())
  ledgerId  String
  ledger    FinanceLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  month     Int
  isClosed  Boolean       @default(false)
  closedAt  DateTime?
  closedBy  String?
  updatedAt DateTime      @updatedAt

  @@unique([ledgerId, month])
}

model FinanceAuditLog {
  id        String            @id @default(cuid())
  ledgerId  String
  ledger    FinanceLedger     @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  rowId     String?
  row       FinanceLedgerRow? @relation(fields: [rowId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  userEmail String?
  action    String
  field     String?
  before    Json?
  after     Json?
  createdAt DateTime          @default(now())

  @@index([ledgerId, createdAt])
  @@index([rowId])
  @@index([userId])
}

model FacebookPost {
  id            String    @id @default(cuid())
  postId        String    @unique
  pageId        String?
  pageName      String?
  message       String?
  picture       String?
  permalinkUrl  String?
  createdTime   DateTime?
  likesCount    Int       @default(0)
  viewsCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)

  // Ad Insights fields
  adSpend      Float?
  adReach      Int?
  adVisits     Int?
  adStatus     String?
  demographics Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstagramPost {
  id            String    @id @default(cuid())
  postId        String    @unique
  igAccountId   String?
  caption       String?
  mediaType     String?   @default("IMAGE")
  mediaUrl      String?
  permalinkUrl  String?
  createdTime   DateTime?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)

  // Ad Insights fields
  adSpend      Float?
  adReach      Int?
  adVisits     Int?
  adStatus     String?
  demographics Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstagramAd {
  id              String   @id @default(cuid())
  adId            String   @unique
  adName          String?
  campaignId      String?
  campaignName    String?
  adSetId         String?
  adSetName       String?
  postId          String?
  caption         String?
  mediaUrl        String?
  permalinkUrl    String?
  status          String?
  spend           Float    @default(0)
  reach           Int      @default(0)
  visits          Int      @default(0)
  likesCount      Int      @default(0)
  commentsCount   Int      @default(0)
  sharesCount     Int      @default(0)
  engagementCount Int      @default(0)
  demographics    Json?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId])
  @@index([postId])
  @@index([syncedAt])
}
